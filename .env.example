# Copy this file to .env (optional tweaks below)
# LLM runs via local Ollama — no cloud API key required.

# Ollama (defaults work if Ollama is running locally with llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Qwen3.x thinking — leave false for snappy RAG answers
OLLAMA_THINK=false
OLLAMA_TIMEOUT=300

# ChromaDB local path (relative to project root)
CHROMA_DB_PATH=./local_data/chroma_db

# Upload directory
UPLOAD_DIR=./local_data/uploads

# FastAPI settings
API_HOST=127.0.0.1
API_PORT=8000

# React (Vite) frontend
FRONTEND_PORT=5173

# PDF OCR for scanned/image PDFs
PDF_OCR_ENABLED=true

# Embeddings & retrieval quality
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto | cuda | cpu | mps  (needs CUDA-enabled PyTorch for GPU)
EMBEDDING_DEVICE=auto
MIN_RELEVANCE_SCORE=0.25

# Logging (writes to local_data/logs/kag.log)
LOG_DIR=./local_data/logs
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
